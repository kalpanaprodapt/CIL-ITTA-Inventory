      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"inventory-mpls-service\",uri=~\"/api/v1/mpls-lsps.*\",status=~\"5..\"}[5m]))/sum(rate(http_server_requests_seconds_count{service=\"inventory-mpls-service\",uri=~\"/api/v1/mpls-lsps.*\"}[5m]))",
          "legendFormat": "{{pod}}",
