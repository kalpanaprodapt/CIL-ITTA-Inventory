      "title": "Country - 5xx ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"inventory-geography-service\",uri=~\"/api/v1/countries.*\",status=~\"5..\"}[5m]))/sum(rate(http_server_requests_seconds_count{service=\"inventory-geography-service\",uri=~\"/api/v1/countries.*\"}[5m]))",
          "legendFormat": "{{pod}}",
