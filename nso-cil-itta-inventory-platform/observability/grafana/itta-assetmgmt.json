        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"inventory-assetmgmt-service\",uri=~\"/api/v1/assets.*\",status=~\"5..\"}[5m]))/sum(rate(http_server_requests_seconds_count{service=\"inventory-assetmgmt-service\",uri=~\"/api/v1/assets.*\"}[5m]))",
          "legendFormat": "{{pod}}",
